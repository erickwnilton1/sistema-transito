<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Boletim - <%= protocol %></title>
    <style>
      body { font-family: Arial, sans-serif; color: #222; line-height: 1.4; }
      .header { background:#162456; color:black; padding:12px; border-radius:6px }
      .section { margin:16px 0; padding:12px; border:1px solid #eee; border-radius:6px }
      table { width:100%; border-collapse: collapse; }
      td, th { padding:6px; vertical-align: top; border-bottom:1px solid #f3f3f3 }
    </style>
  </head>
  <body>
    <div class="header">
      <h2>Boletim de Ocorrência - Protocolo <%= protocol %></h2>
      <div>Registrado em: <%= new Date(createdAt).toLocaleString() %></div>
    </div>

    <div class="section">
      <h3>Dados do Sinistro</h3>
      <table>
        <tr><th>Data</th><td><%= data.dataOcorrencia || '-' %></td></tr>
        <tr><th>Hora</th><td><%= data.horaOcorrencia || '-' %></td></tr>
        <tr><th>Rua</th><td><%= data.rua || '-' %></td></tr>
        <tr><th>Bairro</th><td><%= data.bairro || '-' %></td></tr>
        <tr><th>Ponto de Referência</th><td><%= data.pontoReferencia || '-' %></td></tr>
        <tr><th>Classificação</th><td><%= data.tipoClassificacao || '-' %></td></tr>
      </table>
    </div>

    <div class="section">
      <h3>Veículos Envolvidos</h3>
      <% if (data.veiculos && data.veiculos.length) { %>
        <ul>
          <% data.veiculos.forEach(function(v){ %>
            <li>
              <strong>Placa:</strong> <%= v.placaVeiculo || '-' %> — <strong>Tipo:</strong> <%= v.tipoVeiculo || '-' %> — <strong>Condutor:</strong> <%= v.condutor?.nomeCondutor || '-' %>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p>Sem veículos registrados.</p>
      <% } %>
    </div>

    <div style="font-size:12px; color:#666; margin-top:20px;">
      Este e-mail contém a cópia do boletim registrado. Protocolo: <%= protocol %>
    </div>
  </body>
</html>
